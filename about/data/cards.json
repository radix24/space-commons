[{"title":"0. 우주 첫걸음","intro":"수식이 낯설어도 괜찮은 우주 이야기: 크기, 하늘의 색, 오로라, 유성, 외계 문명, 우주의 역사","cards":[{"id":"scale","level":"기초","title":"우주의 크기","tag":"빛으로 재는 거리"},{"id":"calendar","level":"기초","title":"우주 달력","tag":"138억 년을 1년으로"},{"id":"bluesky","level":"기초","title":"하늘은 왜 파랗고 노을은 붉을까","tag":"공기가 빛을 흩뜨린다"},{"id":"aurora","level":"교양","title":"오로라","tag":"대기가 내는 빛"},{"id":"meteor","level":"기초","title":"혜성과 유성우","tag":"먼지가 타는 별똥별"},{"id":"microg","level":"기초","title":"우주정거장은 왜 무중력일까","tag":"끝없이 떨어지는 중"},{"id":"eht","level":"교양","title":"블랙홀을 찍은 지구 크기 망원경","tag":"사건지평선 망원경"},{"id":"drake","level":"교양","title":"외계 문명은 몇이나 될까","tag":"드레이크 방정식"}]},{"title":"1. 하늘의 좌표와 시간","intro":"하늘을 지도처럼 읽는 법: 좌표, 시간, 계절, 달","cards":[{"id":"coords","level":"기초","title":"천구와 좌표계","tag":"하늘의 주소 쓰는 법"},{"id":"eot","level":"교양","title":"균시차와 아날렘마","tag":"해시계가 시계와 어긋나는 이유"},{"id":"seasons","level":"기초","title":"계절과 자전축의 기울기","tag":"여름이 더운 건 가까워서가 아니다"},{"id":"precession","level":"교양","title":"세차 운동과 북극성의 교대","tag":"2만 6천 년마다 바뀌는 북극의 별"},{"id":"moonphase","level":"기초","title":"달의 위상과 식","tag":"보름달마다 월식이 일어나지 않는 이유"},{"id":"synodic","level":"기초","title":"행성의 겉보기 운동","tag":"회합 주기와 역행 · 고교 지구과학Ⅱ"}]},{"title":"2. 지구와 우주 환경","intro":"지구의 자기장과 바다, 그리고 위성들이 사는 지구 둘레의 우주","cards":[{"id":"declination","level":"교양","title":"진북과 자북, 자기 편각","tag":"나침반은 북극을 가리키지 않는다"},{"id":"paleomag","level":"교양","title":"고지자기와 지자기 역전","tag":"바닷속 바위에 새겨진 자기장의 역사"},{"id":"tides","level":"교양","title":"조석","tag":"바다가 하루에 두 번 부풀어 오르는 이유"},{"id":"spaceweather","level":"교양","title":"우주 날씨: 태양풍과 지구 자기권","tag":"지구를 감싼 보이지 않는 방패"},{"id":"vanallen","level":"교양","title":"밴앨런대","tag":"지구 자기장에 갇힌 방사선"},{"id":"decay","level":"교양","title":"궤도 감쇠와 대기권 재진입","tag":"저궤도 위성은 언젠가 떨어진다"},{"id":"debris","level":"교양","title":"우주 쓰레기와 케슬러 증후군","tag":"부서진 조각이 또 부순다"},{"id":"gps","level":"교양","title":"GPS와 상대성 이론","tag":"시계를 고치지 않으면 하루 11 km 틀린다"}]},{"title":"3. 중력과 궤도","intro":"뉴턴의 중력에서 탐사선 궤도 설계까지","cards":[{"id":"gravity","level":"기초","title":"만유인력","tag":"사과와 달을 같은 법칙으로"},{"id":"keplerlaws","level":"기초","title":"케플러의 세 법칙","tag":"타원, 같은 넓이, 주기와 크기"},{"id":"twobody","level":"교양","title":"이체 문제","tag":"궤도역학의 출발점"},{"id":"invariants","level":"전공","title":"보존량: 에너지, 각운동량, 이심률 벡터","tag":"움직이는 동안 변하지 않는 것"},{"id":"visviva","level":"기초","title":"활력 방정식 (vis-viva)","tag":"궤도 위 속도를 한 줄로"},{"id":"kepler","level":"전공","title":"케플러 방정식","tag":"시간이 주어지면 위치는 어디인가"},{"id":"elements","level":"전공","title":"고전 궤도 요소 6개","tag":"궤도를 숫자 여섯 개로"},{"id":"rocket","level":"기초","title":"로켓 방정식","tag":"왜 로켓은 대부분이 연료인가"},{"id":"hohmann","level":"교양","title":"호만 전이와 이중 타원 전이","tag":"가장 싼 길은 늘 호만일까"},{"id":"plane","level":"교양","title":"궤도면 바꾸기","tag":"방향만 바꾸는 데도 큰 비용"},{"id":"oberth","level":"전공","title":"오베르트 효과","tag":"빠를 때 밟는 가속 페달"},{"id":"soi","level":"교양","title":"영향권과 패치드 코닉","tag":"누구의 중력을 따를 것인가"},{"id":"flyby","level":"전공","title":"중력 도움과 꺾임각","tag":"행성에게 속도를 빌리기"},{"id":"lambert","level":"전공","title":"램버트 문제","tag":"두 점과 시간이 주어지면 궤도는 하나"},{"id":"j2","level":"전공","title":"J2 섭동과 태양동기 궤도","tag":"찌그러진 지구가 궤도면을 돌린다"},{"id":"cr3bp","level":"전공","title":"제한 삼체 문제와 야코비 상수","tag":"갈 수 있는 곳과 갈 수 없는 곳"},{"id":"cw","level":"전공","title":"상대 운동과 랑데부 (CW 방정식)","tag":"앞에 보이는 정거장으로 다가가기"}]},{"title":"4. 행성과 위성","intro":"행성의 온도, 대기, 충돌, 위성, 그리고 다른 별의 행성","cards":[{"id":"roche","level":"교양","title":"로슈 한계","tag":"너무 가까이 가면 부서진다"},{"id":"moon","level":"교양","title":"달의 형성과 멀어지는 달","tag":"거대 충돌에서 태어나 해마다 3.8 cm씩"},{"id":"teq","level":"교양","title":"평형 온도와 온실 효과","tag":"금성이 수성보다 뜨거운 이유"},{"id":"atmos","level":"교양","title":"대기를 붙잡는 힘","tag":"달에 공기가 없는 이유"},{"id":"impact","level":"교양","title":"소행성 충돌과 크레이터","tag":"공룡을 멸종시킨 10 km"},{"id":"hz","level":"교양","title":"생명 가능 지대","tag":"물이 액체로 있을 수 있는 거리"},{"id":"transit","level":"교양","title":"외계행성 찾기: 횡단법","tag":"별빛이 아주 조금 어두워질 때"},{"id":"exodetect","level":"교양","title":"외계 행성을 찾는 방법","tag":"시선 속도 · 식 · 미세 중력 렌즈 · 고교 지구과학Ⅰ"}]},{"title":"5. 별","intro":"빛으로 별을 재고, 별의 탄생부터 최후까지","cards":[{"id":"blackbody","level":"교양","title":"흑체 복사: 별의 색과 온도","tag":"빨간 별은 차갑고 파란 별은 뜨겁다"},{"id":"spectral","level":"기초","title":"별의 분광형과 색","tag":"OBAFGKM · 고교 지구과학Ⅰ"},{"id":"parallax","level":"교양","title":"연주 시차로 별까지 거리 재기","tag":"1초각에 1파섹"},{"id":"magnitude","level":"교양","title":"별의 밝기, 등급, 거리","tag":"5등급 차이가 100배"},{"id":"hrdiagram","level":"기초","title":"H-R도","tag":"별의 온도와 밝기로 그린 지도 · 고교 지구과학Ⅰ"},{"id":"doppler","level":"교양","title":"스펙트럼과 도플러 효과","tag":"빛의 색으로 속도를 잰다"},{"id":"sun","level":"교양","title":"태양의 에너지와 구조","tag":"1초에 4백만 톤이 빛이 된다"},{"id":"starstruct","level":"교양","title":"별의 내부 구조","tag":"핵융합과 에너지 전달 · 고교 지구과학Ⅰ"},{"id":"starbirth","level":"교양","title":"별의 탄생","tag":"차갑고 짙은 가스구름이 무너질 때"},{"id":"stellar","level":"교양","title":"항성 진화","tag":"질량이 별의 일생을 정한다"},{"id":"nucleo","level":"교양","title":"원소의 기원과 초신성","tag":"우리는 별의 재로 만들어졌다"},{"id":"remnants","level":"전공","title":"별의 최후: 백색왜성, 중성자별, 블랙홀","tag":"무엇이 붕괴를 버티는가"},{"id":"gw","level":"전공","title":"중력파","tag":"시공간이 떨린다"}]},{"title":"6. 은하와 우주","intro":"거리 사다리를 올라 우주의 역사까지","cards":[{"id":"distladder","level":"교양","title":"우주 거리 사다리","tag":"한 계단씩 더 멀리"},{"id":"galaxytypes","level":"기초","title":"허블의 은하 분류","tag":"타원 · 나선 · 막대 나선 · 불규칙 · 고교 지구과학Ⅰ"},{"id":"hubble","level":"교양","title":"허블 법칙과 우주 팽창","tag":"멀리 있는 은하일수록 빨리 멀어진다"},{"id":"bigbang","level":"기초","title":"빅뱅 우주론과 그 증거","tag":"우주는 뜨겁고 작은 데서 시작했다 · 고교 지구과학Ⅰ"},{"id":"darkmatter","level":"교양","title":"은하 회전 곡선과 암흑 물질","tag":"보이는 것보다 훨씬 무겁다"},{"id":"cmb","level":"교양","title":"우주 배경 복사","tag":"138억 년 전 빛의 화석"},{"id":"darkenergy","level":"교양","title":"암흑 에너지와 가속 팽창","tag":"우주의 95%는 모른다 · 고교 지구과학Ⅰ"},{"id":"galaxy","level":"교양","title":"은하 진화","tag":"우주가 별을 가장 많이 만든 때"}]}]